---
import Icon from './Icon.astro';
import { formatPostDate } from '../lib/post-date';
interface Props {
  date: Date;
  transitionName?: string;
}

const { date, transitionName } = Astro.props;
const formattedDate = formatPostDate(date);
---

<time class="post-date" datetime={date.toISOString()} transition:name={transitionName} data-post-transition={transitionName}><Icon name="calendar" size={15} /><span>{formattedDate}</span></time>
