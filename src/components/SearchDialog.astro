---
import Icon from './Icon.astro';
---
<dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title">
  <div class="search-panel">
    <h2 id="search-title" class="sr-only">Search</h2>
    <div class="search-input-row">
      <Icon name="search" />
      <label class="sr-only" for="site-search">Search</label>
      <input id="site-search" type="search" placeholder="Search…" autocomplete="off" maxlength="120" />
      <button type="button" class="icon-button" data-close-search aria-label="Close search"><Icon name="x" /></button>
    </div>
    <div class="search-body" hidden>
      <p id="search-status" class="search-status" role="status" aria-live="polite"></p>
      <ul id="search-results" class="search-results" aria-label="Search results"></ul>
    </div>
  </div>
</dialog>
