---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { coverTransition } from '../lib/work-links';
interface Props { id: string; title: string; image: ImageMetadata; }
const { id, title, image } = Astro.props;
---
<figure class="work-hero">
  <div class="work-hero-frame" data-cover-glow>
    <Image class="work-hero-haze" src={image} alt="" aria-hidden="true" width={240} format="webp" loading="eager" />
    <div class="work-hero-cover" transition:name={coverTransition(id)} data-post-transition={coverTransition(id)}>
      <Image src={image} alt={`${title} · 封面`} width={560} format="webp" loading="eager" fetchpriority="high" />
    </div>
  </div>
  <figcaption class="work-hero-title">{title}</figcaption>
</figure>
