---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Icon from '../components/Icon.astro';
import Poetry from '../components/Poetry.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { sortedPosts } from '../lib/posts';
import WorkShelf from '../components/WorkShelf.astro';
import VineDivider from '../components/VineDivider.astro';
import { libraryWorks } from '../lib/works';
const posts = await sortedPosts();
const works = await libraryWorks();
---
<BaseLayout title="Home" description="记录学习中的思考、实践与收获。">
  <h1 class="sr-only">imisslog · Home</h1>
  <section class="home-opening" aria-label="Poetry and contact">
    <Poetry />
    <SocialLinks />
  </section>
  <section id="notes" class="home-chapter" aria-labelledby="notes-title">
    <VineDivider />
    <div class="section-heading">
      <h2 id="notes-title" class="print-heading print-heading--compact">Latest</h2>
      <a class="subtle-link" href="/writing/">View all <Icon name="arrow-up-right" size={14} /></a>
    </div>
    <PostList posts={posts.slice(0, 10)} headingLevel="h3" />
  </section>
  {works.length > 0 && <section class="home-world home-chapter" aria-labelledby="world-title">
    <VineDivider variant="flower" />
    <div class="section-heading"><h2 id="world-title" class="print-heading print-heading--compact">Mirrow World</h2></div>
    <WorkShelf works={works.slice(0, 6)} compact />
    <a class="world-entry-link" href="/mirrow-world/">Enter Mirrow World <Icon name="arrow-up-right" size={16} /></a>
  </section>}
</BaseLayout>

<style>
  .home-chapter > .section-heading { border-bottom: 0; padding-block: 12px 6px; align-items: baseline; }
  .home-chapter .section-heading h2 { display: flex; align-items: baseline; gap: 12px; margin: 0; font-family: var(--font-display); font-size: 24px; font-weight: 600; letter-spacing: -.01em; line-height: 1.5; }
  .home-opening { padding-bottom: 24px; }
  .home-world { margin-top: 22px; }
  @media (max-width: 600px) {
    .home-chapter .section-heading h2 { font-size: 22px; gap: 10px; }
    .home-opening { padding-bottom: 20px; }
    .home-world { margin-top: 18px; }
  }
</style>
