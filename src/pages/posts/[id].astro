---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import { sortedPosts } from '../../lib/posts';
import PostLayout from '../../layouts/PostLayout.astro';

export const getStaticPaths = (async () => {
  const posts = await sortedPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout title={post.data.title} description={post.data.description} date={post.data.pubDate} id={post.id} headings={headings} tags={post.data.tags} preview={post.data.preview} author={post.data.author}>
  <Content />
</PostLayout>
