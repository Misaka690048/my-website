---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page not found" description="This page may have moved or no longer exists." noindex>
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="eyebrow">404 · PAGE NOT FOUND</p>
    <h1 id="not-found-title" class="print-heading">Page not found.</h1>
    <p class="intro-description">This page may have moved or no longer exists.</p>
    <a href="/" class="text-link"><Icon name="arrow-left" size={17} /> Back home</a>
  </section>
</BaseLayout>
